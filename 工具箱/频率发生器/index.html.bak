<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>频率发生器</title>
<style>
*{box-sizing:border-box;font-family:system-ui,sans-serif;margin:0;padding:0}
html,body{height:100%;background:#000;color:#fff}
body{
  background:radial-gradient(circle,#0a102a,#000);
  padding:8px;
  display:flex;align-items:center;justify-content:center
}
.main{
  width:100%;max-width:420px;
  background:rgba(0,0,0,0.8);
  border:1px solid #0ff;
  border-radius:12px;
  padding:14px;
  box-shadow:0 0 20px #0ff
}
.title{
  text-align:center;color:#0ff;text-shadow:0 0 8px #0ff;
  font-size:16px;margin-bottom:12px
}
.channels{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.channel{
  border:1px solid #f0f;border-radius:10px;
  padding:10px;background:rgba(10,10,30,0.5)
}
.channel h3{
  color:#f0f;text-align:center;font-size:13px;
  margin-bottom:8px;text-shadow:0 0 6px #f0f
}
.item{margin-bottom:10px}
.item label{
  display:block;text-align:center;color:#0ff;
  font-size:12px;margin-bottom:4px
}

/* 横向小推杆 */
.slider{
  width:100%;height:6px;border-radius:3px;
  background:#111;-webkit-appearance:none;
  box-shadow:0 0 4px #0ff
}
.slider::-webkit-slider-thumb{
  -webkit-appearance:none;width:16px;height:16px;
  background:#0ff;border-radius:4px;box-shadow:0 0 8px #0ff
}

.freq-input{
  width:100%;height:30px;
  background:#111;color:#fff;border:1px solid #0ff;border-radius:6px;
  text-align:center;font-size:12px;margin-top:4px
}
select{
  width:100%;height:32px;
  background:#111;color:#fff;border:1px solid #f0f;border-radius:6px;
  font-size:12px;text-align:center
}
.val{
  text-align:center;font-size:11px;color:#aaa;margin-top:2px
}
.btns{display:flex;gap:8px;margin-top:12px}
button{
  flex:1;height:38px;border:none;border-radius:8px;
  font-size:14px;font-weight:bold;cursor:pointer
}
.start{background:#0ff;color:#000;box-shadow:0 0 10px #0ff}
.stop{background:#f0f;color:#000;box-shadow:0 0 10px #f0f}
button:disabled{background:#222;color:#666;box-shadow:none}
</style>
</head>
<body>

<div class="main">
  <div class="title">🎛️ 双声道频率发生器</div>
  <div class="channels">
    <!-- 左 -->
    <div class="channel">
      <h3>左声道</h3>
      <div class="item">
        <label>频率 <span id="lfv">440</span>Hz</label>
        <input type="range" class="slider" id="lf" min="1" max="20000" value="440">
        <input type="number" class="freq-input" id="lfi" value="440">
      </div>
      <div class="item">
        <label>音量 <span id="lvv">50</span>%</label>
        <input type="range" class="slider" id="lv" min="0" max="100" value="50">
      </div>
      <div class="item">
        <select id="lw">
          <option value="sine">正弦波</option>
          <option value="square">方波</option>
          <option value="triangle">三角波</option>
          <option value="sawtooth">锯齿波</option>
        </select>
      </div>
    </div>
    <!-- 右 -->
    <div class="channel">
      <h3>右声道</h3>
      <div class="item">
        <label>频率 <span id="rfv">440</span>Hz</label>
        <input type="range" class="slider" id="rf" min="1" max="20000" value="440">
        <input type="number" class="freq-input" id="rfi" value="440">
      </div>
      <div class="item">
        <label>音量 <span id="rvv">50</span>%</label>
        <input type="range" class="slider" id="rv" min="0" max="100" value="50">
      </div>
      <div class="item">
        <select id="rw">
          <option value="sine">正弦波</option>
          <option value="square">方波</option>
          <option value="triangle">三角波</option>
          <option value="sawtooth">锯齿波</option>
        </select>
      </div>
    </div>
  </div>
  <div class="btns">
    <button class="start" id="start">发声</button>
    <button class="stop" id="stop" disabled>停止</button>
  </div>
</div>

<script>
let ctx,ol,gl,pl,or,gr,pr;

function bind(slider,input,show,vol,volShow){
  slider.oninput=()=>{
    show.textContent=slider.value;
    input.value=slider.value;
    if(ol&&slider===lf)ol.frequency.value=lf.value;
    if(or&&slider===rf)or.frequency.value=rf.value;
  }
  input.onchange=()=>{
    let v=Math.max(1,Math.min(20000,+input.value||440));
    input.value=v;slider.value=v;show.textContent=v;
    if(ol&&input===lfi)ol.frequency.value=v;
    if(or&&input===rfi)or.frequency.value=v;
  }
  vol.oninput=()=>{
    volShow.textContent=vol.value;
    if(gl&&vol===lv)gl.gain.value=lv.value/100;
    if(gr&&vol===rv)gr.gain.value=rv.value/100;
  }
}

bind(lf,lfi,lfv,lv,lvv);
bind(rf,rfi,rfv,rv,rvv);

lw.onchange=()=>{if(ol)ol.type=lw.value};
rw.onchange=()=>{if(or)or.type=rw.value};

start.onclick=()=>{
  ctx=new (window.AudioContext||webkitAudioContext);
  //左
  pl=ctx.createStereoPanner();pl.pan.value=-1;
  gl=ctx.createGain();gl.gain.value=lv.value/100;
  ol=ctx.createOscillator();ol.type=lw.value;ol.frequency.value=lf.value;
  ol.connect(gl);gl.connect(pl);pl.connect(ctx.destination);
  //右
  pr=ctx.createStereoPanner();pr.pan.value=1;
  gr=ctx.createGain();gr.gain.value=rv.value/100;
  or=ctx.createOscillator();or.type=rw.value;or.frequency.value=rf.value;
  or.connect(gr);gr.connect(pr);pr.connect(ctx.destination);

  ol.start();or.start();
  start.disabled=true;stop.disabled=false;
}

stop.onclick=()=>{
  ol?.stop();or?.stop();ol=or=null;
  start.disabled=false;stop.disabled=true;
}
</script>
</body>
</html>
